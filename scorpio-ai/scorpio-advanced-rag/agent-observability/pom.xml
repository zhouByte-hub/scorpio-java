<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zhoubyte</groupId>
        <artifactId>scorpio-advanced-rag</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-observability</artifactId>
    <name>agent-observability</name>
    <description>Agent 可观测示例：Spring AI 原生 OTel 埋点 → OTel Collector（过滤/采样）→ Langfuse（Trace 可视化/评测/成本看板）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Micrometer Observation → OpenTelemetry 桥接：ChatClient/ChatModel/Tool 自动产出 gen_ai.* Span -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- OTLP 导出器：Trace 经 OTLP 上报到 OTel Collector -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 对话模型（默认 Ollama 本地推理）；starter 传递 spring-ai-client-chat，
             自带 ChatClient/Advisor/ChatMemory 与 Micrometer Observation 自动埋点 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            DashScope（百炼 qwen）双通道：按需激活，缺 API Key 时默认构建/启动不受影响。
            mvn -P dashscope spring-boot:run 并配合 spring.profiles.active=dashscope 与 DASHSCOPE_API_KEY。
        -->
        <profile>
            <id>dashscope</id>
            <dependencies>
                <dependency>
                    <groupId>com.alibaba.cloud.ai</groupId>
                    <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
